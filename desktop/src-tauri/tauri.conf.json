{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft Study",
  "version": "0.1.0",
  "identifier": "io.github.u01234567.minecraftstudy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minecraft Study",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "visible": true,
        "focus": true,
        "focusable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jonas de Brouwer",
    "copyright": "Copyright © 2026 Jonas de Brouwer",
    "category": "Education",
    "shortDescription": "Minecraft Study desktop application",
    "longDescription": "Desktop application for participating in the Minecraft Study.",
    "resources": [
      "resources/payload/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}